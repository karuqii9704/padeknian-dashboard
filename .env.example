DATABASE_URL="postgresql://padeknian:padeknian@127.0.0.1:15432/padeknian"
NEXTAUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
NEXTAUTH_URL="http://localhost:3000"

S3_ENDPOINT="http://localhost:9000"
# Alamat storage yang bisa dijangkau BROWSER (dipakai menandatangani URL unduhan). Di Docker, S3_ENDPOINT
# biasanya http://minio:9000 sedangkan alamat publiknya http://localhost:9000 atau domain storage.
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_KEY="minioadmin"
S3_SECRET="minioadmin"
S3_BUCKET="bukti-dukung"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Seed admin awal (npm run seed). Wajib diisi; tidak ada password default.
ADMIN_NIP="198001012005011001"
ADMIN_NAMA="Administrator"
ADMIN_EMAIL=""
ADMIN_PASSWORD="ganti-password-admin-ini"

# Opsional: seed hari libur nasional bertanggal tetap tahun berjalan (contoh).
SEED_HARI_LIBUR_CONTOH="false"
